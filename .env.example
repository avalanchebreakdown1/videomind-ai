# Export these in your shell. No automatic .env loading.
VIDEOMIND_MODEL=base
VIDEOMIND_DEVICE=cpu
VIDEOMIND_COMPUTE_TYPE=int8
VIDEOMIND_LANGUAGE=
VIDEOMIND_CHUNK_SECONDS=300
VIDEOMIND_OVERLAP_SECONDS=2
VIDEOMIND_ASR_RETRIES=1
VIDEOMIND_CPU_THREADS=4
VIDEOMIND_MODEL_DIR=.cache/models
VIDEOMIND_LOCAL_FILES_ONLY=false
VIDEOMIND_PROCESS_TIMEOUT=3600
VIDEOMIND_STORAGE_DIR=storage
VIDEOMIND_MAX_SOURCE_BYTES=268435456
VIDEOMIND_MAX_DURATION_SECONDS=14400
VIDEOMIND_DOWNLOAD_TIMEOUT=900
VIDEOMIND_SOCKET_TIMEOUT=20
VIDEOMIND_MAX_JOBS=5
# M3: different checkpoint required; verification is opt-in per API job / CLI verify command.
VIDEOMIND_VERIFY_MODEL=small
VIDEOMIND_VERIFY_WORD_THRESHOLD=0.65
VIDEOMIND_VERIFY_SECTION_SECONDS=30
VIDEOMIND_VERIFY_CONTEXT_SECONDS=2
VIDEOMIND_VERIFY_RECHECK_CONTEXT_SECONDS=6
VIDEOMIND_VERIFY_ALIGNMENT_TOLERANCE_SECONDS=1
VIDEOMIND_VERIFY_GAP_SECONDS=8
VIDEOMIND_VERIFY_MAX_SECTIONS=200
VIDEOMIND_VERIFY_RECHECK=true

# Direct writing and local frontend (export settings; root .env is not auto-loaded).
VIDEOMIND_WRITE_MODEL=qwen2.5-coder:7b
VIDEOMIND_WRITE_ENDPOINT=http://127.0.0.1:11434
VIDEOMIND_API_URL=http://127.0.0.1:8000
